# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- iCal feeds (Airbnb & Booking.com export URLs) ---
# Airbnb: Listing > Availability > Sync calendars > "Export calendar" link
# Booking.com: Extranet > Calendar > Sync calendars > iCal export URL
ICAL_URL_AIRBNB=https://www.airbnb.com/calendar/ical/XXXXXXX.ics?s=XXXXXXXXXXXXXXXX
# (The link Booking.com gives you is on ical.booking.com, not admin.booking.com.)
ICAL_URL_BOOKING=https://ical.booking.com/v1/export?t=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# --- Resend (booking request emails) ---
# Create a free account at resend.com, verify a sending domain (or use
# their onboarding@resend.dev test address until you attach your own domain),
# and create an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Address the "From" header will use. Must be on a domain verified in Resend.
RESEND_FROM_EMAIL="Patras Apartment <bookings@yourdomain.com>"

# Where booking request notifications get sent (your inbox).
OWNER_NOTIFICATION_EMAIL=you@example.com

# --- Site ---
# Used for canonical URLs, Open Graph tags, and JSON-LD. Update once you
# have a real domain; the Vercel default subdomain works fine until then.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# --- Google Static Maps (optional) ---
# When set, the Location section renders a branded static map (custom map skin
# + terracotta pin) instead of the plain interactive embed. Enable the
# "Maps Static API" in Google Cloud, create an API key, and RESTRICT it to
# your domain (HTTP referrers) — this value is exposed to the browser.
# Leave unset to keep the free keyless interactive map embed.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Analytics (optional, privacy-friendly / cookieless) ---
# When NEXT_PUBLIC_ANALYTICS_DOMAIN is set, a Plausible-compatible script is
# loaded — no cookies, so no consent banner required. Leave unset to disable
# analytics entirely (nothing is injected). Set this to the domain you
# registered in your analytics dashboard, e.g. patrasapartment.com
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Optional: override the analytics script URL to point at a self-hosted
# Plausible instance or a proxied script. Defaults to Plausible cloud.
NEXT_PUBLIC_ANALYTICS_SRC=

# --- Payments: Viva.com Smart Checkout (optional) ---
# With these unset, payments are disabled and the booking flow stays
# request-only (no "Approve & send payment link" button appears). Fill them
# in to enable the pay-after-you-confirm flow. Start with DEMO credentials.
#
# "demo" (default) uses Viva's demo hosts; set to "production" to go live.
VIVA_ENV=demo
# Smart Checkout OAuth2 credentials (Viva self-care: Settings > API Access >
# "Smart Checkout Credentials"). Used to create payment orders.
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
# Payment source code (Viva self-care: Sales > Online payments > Websites/Apps).
# On that source, Protocol = https, Domain Name = your host WITH the www that
# the site actually serves (the bare domain 308-redirects, which breaks Viva's
# strict redirect matching), and the Success/Failure URLs are PATHS under it:
#   Success URL: booking/success      Failure URL: booking/failure
VIVA_SOURCE_CODE=
# Webhook verification key (Viva self-care: the value returned by the
# "Webhook verification key" / messages config token). Echoed back on Viva's
# GET verification request to <site>/api/viva/webhook
VIVA_WEBHOOK_VERIFICATION_KEY=

# Secret used to HMAC-sign the owner's action buttons (approve, deposit
# send/resolve) AND the owner admin session cookie. Generate a long random
# value, e.g.  openssl rand -base64 32
# Use a DIFFERENT value per environment (production / preview / local): anyone
# who can read this secret can mint a valid admin session for that environment.
BOOKING_APPROVAL_SECRET=

# --- Owner admin (optional; /api/admin/bookings) ---
# Password for the owner-only page that lists confirmed direct bookings and can
# REOPEN one (deletes it here, freeing those dates on this site immediately — it
# does not refund the guest or notify Airbnb/Booking.com). Signing in exchanges
# this for an 8-hour cookie signed with BOOKING_APPROVAL_SECRET above.
# The admin page is OFF unless BOTH this and BOOKING_APPROVAL_SECRET are set.
ADMIN_PASSWORD=

# --- Damage deposit (optional; refundable card pre-authorization) ---
# The owner sends the guest a HOLD link 1–2 days before arrival (a button in the
# PAID confirmation email). Creating the hold uses the Smart Checkout creds
# above. CAPTURING (on damage) or RELEASING the hold uses Viva's legacy Payment
# API with BASIC auth — DIFFERENT credentials:
#   Viva self-care: Settings > API Access → Merchant ID + API key. Also tick
#   "Allow recurring payments and pre-auth captures via API" there.
# With these unset, the owner can still SEND holds, but must RELEASE/CAPTURE them
# in the Viva portal instead of from the site. Deposit amount lives in
# content/siteConfig.ts (deposit.amountEur; set to 0 to disable the flow).
VIVA_MERCHANT_ID=
VIVA_API_KEY=
#
# Once the VIVA_* values above are filled in, verify the whole lot in one shot:
#   npm run viva:check
# It exercises the real Viva account + the deployed site and prints a pass/fail
# line per GO_LIVE_CHECKLIST Stage-5 box. Secrets are masked in its output.

# --- Direct-booking store (recommended; closes the double-booking loop) ---
# When set, this KV store powers four things:
#   (a) paid direct bookings block those dates in this site's own calendar and
#       are published at /api/calendar.ics for Airbnb/Booking.com to import;
#   (b) short-lived HOLDS placed when a pay link is sent, so the same nights
#       aren't offered to a second guest during the ~30-min payment window;
#   (c) PENDING-ORDER records so the webhook can verify the paid amount against
#       what we actually charged;
#   (d) an append-only AUDIT log of request/approve/payment events;
#   (e) RATE LIMITING (per-IP + per-recipient-email on the request form, and
#       per-IP on the owner/webhook endpoints).
# Unset = the site still runs and the webhook still refuses to trust the wire,
# but holds, amount-vs-order verification, the audit trail, and durable rate
# limiting are unavailable (rate limiting falls back to weak per-instance memory).
#
# On Vercel: add a Redis store from the Marketplace (Upstash) — these two are
# injected automatically. Elsewhere: create an Upstash Redis DB and paste its
# REST URL + token (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work).
KV_REST_API_URL=
KV_REST_API_TOKEN=
