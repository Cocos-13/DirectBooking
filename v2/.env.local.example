# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- iCal feeds (Airbnb & Booking.com export URLs) ---
# Airbnb: Listing > Availability > Sync calendars > "Export calendar" link
# Booking.com: Extranet > Calendar > Sync calendars > iCal export URL
ICAL_URL_AIRBNB=https://www.airbnb.com/calendar/ical/XXXXXXX.ics?s=XXXXXXXXXXXXXXXX
ICAL_URL_BOOKING=https://admin.booking.com/hotel/hoteladmin/ical.html?t=XXXXXXXXXXXXXXXX

# --- Resend (booking request emails) ---
# Create a free account at resend.com, verify a sending domain (or use
# their onboarding@resend.dev test address until you attach your own domain),
# and create an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Address the "From" header will use. Must be on a domain verified in Resend.
RESEND_FROM_EMAIL="Patras Apartment <bookings@yourdomain.com>"

# Where booking request notifications get sent (your inbox).
OWNER_NOTIFICATION_EMAIL=you@example.com

# --- Site ---
# Used for canonical URLs, Open Graph tags, and JSON-LD. Update once you
# have a real domain; the Vercel default subdomain works fine until then.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# --- Google Static Maps (optional) ---
# When set, the Location section renders a branded static map (custom map skin
# + terracotta pin) instead of the plain interactive embed. Enable the
# "Maps Static API" in Google Cloud, create an API key, and RESTRICT it to
# your domain (HTTP referrers) — this value is exposed to the browser.
# Leave unset to keep the free keyless interactive map embed.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Analytics (optional, privacy-friendly / cookieless) ---
# When NEXT_PUBLIC_ANALYTICS_DOMAIN is set, a Plausible-compatible script is
# loaded — no cookies, so no consent banner required. Leave unset to disable
# analytics entirely (nothing is injected). Set this to the domain you
# registered in your analytics dashboard, e.g. patrasapartment.com
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Optional: override the analytics script URL to point at a self-hosted
# Plausible instance or a proxied script. Defaults to Plausible cloud.
NEXT_PUBLIC_ANALYTICS_SRC=

# --- Payments: Viva.com Smart Checkout (optional) ---
# With these unset, payments are disabled and the booking flow stays
# request-only (no "Approve & send payment link" button appears). Fill them
# in to enable the pay-after-you-confirm flow. Start with DEMO credentials.
#
# "demo" (default) uses Viva's demo hosts; set to "production" to go live.
VIVA_ENV=demo
# Smart Checkout OAuth2 credentials (Viva self-care: Settings > API Access >
# "Smart Checkout Credentials"). Used to create payment orders.
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
# Payment source code (Viva self-care: Sales > Websites/Apps > your source).
# The source's success/failure redirect URLs must point at:
#   <site>/booking/success   and   <site>/booking/failure
VIVA_SOURCE_CODE=
# Webhook verification key (Viva self-care: the value returned by the
# "Webhook verification key" / messages config token). Echoed back on Viva's
# GET verification request to <site>/api/viva/webhook
VIVA_WEBHOOK_VERIFICATION_KEY=

# Secret used to HMAC-sign the owner's "Approve & send payment link" button.
# Generate a long random value, e.g.  openssl rand -base64 32
BOOKING_APPROVAL_SECRET=
